{
  "name": "korea-mcp",
  "version": "0.1.0",
  "description": "MCP server that helps AI agents get around Korea: subway routes in English, fares, public holidays and practical guides. Works with no API key.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "korea",
    "seoul",
    "subway",
    "metro",
    "travel",
    "claude",
    "ai-agent"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "korea-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "data",
    "README.md",
    "LICENSE",
    "DATA_LICENSE.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "data:subway": "node scripts/build-subway.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
